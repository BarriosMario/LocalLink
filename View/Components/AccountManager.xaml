<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:LocalLink.ViewModel.HomeViewModel"
             xmlns:model="clr-namespace:LocalLink.Model"
             x:DataType="vm:AcountViewModel"
             x:Class="LocalLink.View.Components.AccountManager"
             InputTransparent="True" 
             CascadeInputTransparent="False">

    <Grid>
        <BoxView x:Name="Overlay" 
                 BackgroundColor="#80000000" 
                 IsVisible="False" 
                 Opacity="0">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMenuCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="BottomMenu"
                BackgroundColor="White"
                Padding="20"
                VerticalOptions="End"
                TranslationY="600"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25,25,0,0"/>
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Opacity="0.2" Radius="10"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="¿Quién está comprando?" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="Black"/>
                    <Button Grid.Column="1" 
                            Text="✕" 
                            BackgroundColor="Transparent" 
                            TextColor="Black" 
                            Command="{Binding CloseMenuCommand}"/>
                </Grid>

                <CollectionView ItemsSource="{Binding Perfiles}" 
                                HeightRequest="220"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:AccountSnapshot">
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="0,10" ColumnSpacing="15">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AcountViewModel}}, Path=SwitchAccountCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <Border Grid.Column="0"
                                        WidthRequest="45" 
                                        HeightRequest="45" 
                                        Stroke="LightGray"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="22.5"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ProfileImageUrl, FallbackValue='default_avatar.png'}" 
                                           Aspect="AspectFill"/>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Username}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="Black"/>

                                    <Label FontSize="12" TextColor="Gray" Text="Haz clic para cambiar">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" 
                                                         Binding="{Binding Email}" 
                                                         Value="{Binding Source={RelativeSource AncestorType={x:Type vm:AcountViewModel}}, Path=CurrentUser.Email}">
                                                <Setter Property="Text" Value="● Sesión activa" />
                                                <Setter Property="TextColor" Value="DarkCyan" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <Button Grid.Column="2"
                                        Text="Cambiar"
                                        TextColor="DarkCyan"
                                        BackgroundColor="Transparent"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AcountViewModel}}, Path=SwitchAccountCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" 
                                                     Binding="{Binding Email}" 
                                                     Value="{Binding Source={RelativeSource AncestorType={x:Type vm:AcountViewModel}}, Path=CurrentUser.Email}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,5"/>

                <Button Text="Gestionar cuentas" 
                        BackgroundColor="#FFF0F0" 
                        TextColor="DarkCyan"  
                        FontAttributes="Bold" CornerRadius="10"
                        Command="{Binding AddProfileCommand}"
                        Margin="0,10,0,10"/>

                <Button Text="Cerrar sesión" 
                        BackgroundColor="#FFF0F0" 
                        TextColor="Red" 
                        FontAttributes="Bold" CornerRadius="10"
                        Command="{Binding LogoutCommand}"
                        Margin="0,10,0,10"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
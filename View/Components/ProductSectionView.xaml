<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LocalLink.Model"
             xmlns:controls="clr-namespace:LocalLink.View.Components"
             x:Class="LocalLink.View.Components.ProductSectionView">

    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="White">
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*, Auto" Padding="15,12">
                <Label Text="{Binding Title}" 
                       FontSize="18" 
                       FontAttributes="Bold" />

                <Button Grid.Column="1"
                        Text="Ver más"
                        FontSize="12"
                        TextColor="{StaticResource Primary}"
                        BackgroundColor="Transparent"
                        Command="{Binding SeeMoreCommand}"
                        CommandParameter="{Binding Title}" />
            </Grid>

            <BoxView HeightRequest="1" Color="#EEEEEE" />

            <ScrollView Orientation="Horizontal" HeightRequest="280">
                <HorizontalStackLayout Padding="10" Spacing="5" 
                                       BindableLayout.ItemsSource="{Binding Products}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <controls:ProductCardView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>
    </Border>
</ContentView>
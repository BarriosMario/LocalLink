<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:LocalLink.ViewModel.HomeViewModel"
             x:DataType="vm:AcountViewModel"
             x:Class="LocalLink.View.Components.AccountSettingsManager"
             IsVisible="False"
             InputTransparent="True" 
             CascadeInputTransparent="False">

    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid>
        <BoxView x:Name="Overlay" 
                 BackgroundColor="#80000000" 
                 IsVisible="False" 
                 Opacity="0"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSettingsCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="BottomMenu"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1C1C1C}"
                Padding="20,10,20,20"
                VerticalOptions="End"
                TranslationY="800"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25,25,0,0"/>
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=Black, Dark=Transparent}" Offset="0,-5" Opacity="0.1" Radius="15"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <BoxView WidthRequest="40" HeightRequest="4" 
                         Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" 
                         HorizontalOptions="Center" Margin="0,0,0,5"/>

                <ScrollView VerticalScrollBarVisibility="Never" MaximumHeightRequest="600">
                    <VerticalStackLayout Spacing="20">

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout>
                                <Label Text="Configuración" FontSize="20" FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
                                <Label Text="{Binding CurrentUser.Username, StringFormat='Cuenta: {0}'}" 
                                       FontSize="13" TextColor="DarkCyan" Margin="0,-2,0,0"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="✕" FontSize="18"
                                    BackgroundColor="Transparent" 
                                    TextColor="{AppThemeBinding Light=Gray, Dark=#BBBBBB}" 
                                    Command="{Binding CloseSettingsCommand}"/>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"/>

                        <Label Text="Preferencias de la App" FontSize="14" FontAttributes="Bold" TextColor="Gray"/>

                        <VerticalStackLayout Spacing="15" Margin="5,0">

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Modo Oscuro" 
                                       VerticalOptions="Center" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                       FontSize="15"/>
                                <Switch Grid.Column="1" 
                                        IsToggled="{Binding CurrentUser.Settings.DarkMode, Mode=TwoWay}"
                                        HorizontalOptions="End"
                                        Margin="-100,0">
                                    <Switch.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="Toggled" 
                                            Command="{Binding SaveSettingsDirectlyCommand}" />
                                    </Switch.Behaviors>
                                </Switch>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Notificaciones" 
                                       VerticalOptions="Center" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                       FontSize="15"/>
                                <Switch Grid.Column="1" 
                                        IsToggled="{Binding CurrentUser.Settings.NotificationsEnabled, Mode=TwoWay}"
                                        HorizontalOptions="End"
                                        Margin="-100,0">
                                    <Switch.Behaviors>
                                        <toolkit:EventToCommandBehavior 
                                            EventName="Toggled" 
                                            Command="{Binding SaveSettingsDirectlyCommand}" />
                                    </Switch.Behaviors>
                                </Switch>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="5,0">
                                <Label Text="Idioma" 
                                       VerticalOptions="Center" 
                                       TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                       FontSize="15"/>

                                <Picker Grid.Column="1"
                                        SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"
                                        FontSize="14"
                                        TextColor="DarkCyan"
                                        HorizontalOptions="End">
                                    <Picker.Items>
                                        <x:String>Español</x:String>
                                        <x:String>Inglés</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Grid>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}"/>

                        <Border Stroke="DarkCyan" StrokeThickness="1" Padding="15" 
                                BackgroundColor="{AppThemeBinding Light=#F0F9F9, Dark=#152A2A}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Spacing="2" Grid.Column="0">
                                        <Label Text="Perfil de Vendedor" 
                                               FontAttributes="Bold" 
                                               TextColor="DarkCyan" 
                                               FontSize="16"/>

                                        <Label Text="Vende tus productos localmente" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=#666, Dark=#AAAAAA}"
                                               IsVisible="{Binding IsSellerEnabled, Converter={StaticResource InvertedBoolConverter}}"/>

                                        <HorizontalStackLayout Spacing="5" IsVisible="{Binding IsSellerEnabled}">
                                            <Label Text="¡Ya eres parte de la comunidad!" 
                                                   FontSize="12" 
                                                   TextColor="DarkCyan"
                                                   FontAttributes="Italic"/>
                                            <Image Source="check_circle.png" 
                                                   HeightRequest="14" 
                                                   WidthRequest="14"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" 
                                                         Spacing="0" 
                                                         HorizontalOptions="End"
                                                         IsVisible="{Binding IsSellerEnabled}">
                                        <Label Text="Modo Vendedor" 
                                               FontSize="10" 
                                               HorizontalOptions="Start" 
                                               TextColor="DarkCyan" 
                                               FontAttributes="Bold"/>
                                        <Switch IsToggled="{Binding IsSellerModeActive}"
                                                ThumbColor="DarkCyan"
                                                OnColor="#B2D8D8"
                                                HorizontalOptions="Center" 
                                                Scale="0.8"
                                                Margin="0,0,-100,0">
                                            <Switch.Behaviors>
                                                <toolkit:EventToCommandBehavior 
                                                    EventName="Toggled" 
                                                    Command="{Binding ToggleSellerModeCommand}" />
                                            </Switch.Behaviors>
                                        </Switch>
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Text="CONVERTIRME EN VENDEDOR" 
                                        IsVisible="{Binding IsSellerEnabled, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="DarkCyan" 
                                        TextColor="White"
                                        FontAttributes="Bold" 
                                        CornerRadius="10"
                                        HeightRequest="45"
                                        Command="{Binding EnableSellerCommand}"/>

                                <Button Text="GESTIONAR MIS PRODUCTOS" 
                                        IsVisible="{Binding IsSellerEnabled}"
                                        BackgroundColor="Transparent" 
                                        TextColor="DarkCyan"
                                        BorderColor="DarkCyan"
                                        BorderWidth="2" 
                                        FontAttributes="Bold" 
                                        CornerRadius="10"
                                        HeightRequest="45"
                                        Command="{Binding ManageStoreCommand}"/>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LocalLink.Model"
             x:Class="LocalLink.View.Components.ProductItemView">

    <SwipeView>
        <SwipeView.RightItems>
            <SwipeItems Mode="Reveal">
                <SwipeItem Text="Eliminar"
                           BackgroundColor="Red"
                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}"
                           CommandParameter="{Binding .}" />
            </SwipeItems>
        </SwipeView.RightItems>

        <Border Margin="0,5" 
                Padding="12" 
                StrokeThickness="0.5" 
                Stroke="Gray"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#252525}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="90, *, Auto" ColumnSpacing="15">

                <Border Grid.Column="0" HeightRequest="80" WidthRequest="80">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Image Source="{Binding MainImage}" Aspect="AspectFill" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding Name}" 
                           FontAttributes="Bold" 
                           FontSize="17" 
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           MaxLines="1" />

                    <Label Text="{Binding Description}" 
                           FontSize="12" 
                           TextColor="Gray" 
                           MaxLines="2" 
                           LineBreakMode="TailTruncation" />

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8" HorizontalOptions="End">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Cantidad" FontSize="11" TextColor="Gray" HorizontalTextAlignment="End"/>
                        <Label Text="{Binding Stock}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding Price, StringFormat='${0:F2}'}" 
                            FontSize="22" 
                            FontAttributes="Bold" 
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            HorizontalTextAlignment="End"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </SwipeView>
</ContentView>
